#!/system/bin/sh
# resh — Rex's Shell
# Canonical runtime launcher

MOD="/data/adb/modules/rexshell/files"
RESH_HOME="/sdcard/resh"
RESH_PKG="/data/adb/resh"
# dpkg installs Termux debs here (their internal paths are data/data/com.termux/files/usr/...)
TPFX="$RESH_PKG/data/data/com.termux/files/usr"

export REXSHELL_ACTIVE=1
export HOME="/data/adb/ssh/root"

mkdir -p \
  "$RESH_HOME/config" "$RESH_HOME/bin" \
  "$RESH_PKG/bin" "$RESH_PKG/lib" \
  "$TPFX/bin" "$TPFX/lib" \
  "$RESH_PKG/var/lib/apt/lists"

# Priority: user scripts > dpkg-installed > resh-pkg legacy > module > system
export PATH="$RESH_HOME/bin:$TPFX/bin:$RESH_PKG/bin:$MOD/bin:/system/bin:/system/xbin"
export LD_LIBRARY_PATH="$TPFX/lib:$RESH_PKG/lib:$MOD/lib:/system/lib64:/vendor/lib64"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

mkdir -p \
  "$HOME/.config/zsh" \
  "$HOME/.local/share" \
  "$HOME/.cache/zsh" \
  "$HOME/.local/state/zsh"

# Zsh functions are nested several levels deep.
# Include the complete tree so autoload can find things like:
#   Completion/Base/_call_program
#   VCS_Info/Backends/VCS_INFO_detect_git
#   Misc/add-zsh-hook

FPATH=""

while IFS= read -r dir; do
    [ -d "$dir" ] || continue

    if [ -z "$FPATH" ]; then
        FPATH="$dir"
    else
        FPATH="$FPATH:$dir"
    fi
done <<EOF
$(find "$MOD/share/zsh/functions" -type d 2>/dev/null | sort)
EOF

export FPATH

export ZDOTDIR="$MOD/config/zsh"
export HISTFILE="$RESH_HOME/history"
export HISTSIZE=1000000
export SAVEHIST=1000000

ZSH="$MOD/bin/zsh"

if [ ! -x "$ZSH" ]; then
    echo "ERROR: bundled zsh not found: $ZSH"
    exit 1
fi

exec "$ZSH" --login
