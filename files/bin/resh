#!/system/bin/sh
# resh — rexshell launcher

MOD="/data/adb/modules/rexshell/files"
RESH="/data/media/0/resh"
TPFX="$RESH/usr"

export REXSHELL_ACTIVE=1
export HOME="/data/adb/ssh/root"
export TMPDIR="$RESH/tmp"

mkdir -p \
  "$RESH/bin" "$RESH/tmp" "$RESH/config" \
  "$TPFX/bin" "$TPFX/lib" \
  "$HOME/.config/zsh" \
  "$HOME/.local/share" \
  "$HOME/.cache/zsh" \
  "$HOME/.local/state/zsh"

chmod +x "$RESH/bin/"* 2>/dev/null || true

# Auto-restore: dpkg db empty but manifest exists = new device, old sdcard
MANIFEST="$RESH/packages"
DPKG_STATUS="$TPFX/var/lib/dpkg/status"
if [ -f "$MANIFEST" ] && [ -s "$MANIFEST" ] && [ ! -s "$DPKG_STATUS" ]; then
  echo "[resh] restoring $(wc -l < "$MANIFEST") package(s)..."
  "$MOD/bin/resh-pkg" restore
fi

export PATH="$RESH/bin:$TPFX/bin:$MOD/bin:/system/bin:/system/xbin"
export LD_LIBRARY_PATH="$TPFX/lib:$MOD/lib:/system/lib64:/vendor/lib64"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# FPATH: static colon-separated list built at launch
# find is still needed since the functions tree is deep, but it's one find
# on the module dir (read-only, likely cached) not user data
export FPATH="$(find "$MOD/share/zsh/functions" -type d 2>/dev/null | sort | tr '\n' ':' | sed 's/:$//')"

export ZDOTDIR="$MOD/config/zsh"
export HISTFILE="$RESH/history"
export HISTSIZE=1000000
export SAVEHIST=1000000

ZSH="$MOD/bin/zsh"
[ -x "$ZSH" ] || { echo "ERROR: bundled zsh not found: $ZSH"; exit 1; }
exec "$ZSH" --login
