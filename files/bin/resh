#!/system/bin/sh
# resh — Rex's Shell
# Canonical runtime launcher

MOD="/data/adb/modules/rexshell/files"
RESH_HOME="/sdcard/resh"

export REXSHELL_ACTIVE=1
export HOME="/data/adb/ssh/root"

# Persistent user dir — survives module updates and reflashes
mkdir -p "$RESH_HOME/bin" "$RESH_HOME/lib" "$RESH_HOME/config"

# User bins/libs take precedence over module bundled ones
export PATH="$RESH_HOME/bin:$MOD/bin:/system/bin:/system/xbin"
export LD_LIBRARY_PATH="$RESH_HOME/lib:$MOD/lib:/system/lib64:/vendor/lib64"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

mkdir -p \
  "$HOME/.config/zsh" \
  "$HOME/.local/share" \
  "$HOME/.cache/zsh" \
  "$HOME/.local/state/zsh"

# Zsh functions are nested several levels deep.
# Include the complete tree so autoload can find things like:
#   Completion/Base/_call_program
#   VCS_Info/Backends/VCS_INFO_detect_git
#   Misc/add-zsh-hook

FPATH=""

while IFS= read -r dir; do
    [ -d "$dir" ] || continue

    if [ -z "$FPATH" ]; then
        FPATH="$dir"
    else
        FPATH="$FPATH:$dir"
    fi
done <<EOF
$(find "$MOD/share/zsh/functions" -type d 2>/dev/null | sort)
EOF

export FPATH

export ZDOTDIR="$MOD/config/zsh"
export HISTFILE="$RESH_HOME/history"
export HISTSIZE=1000000
export SAVEHIST=1000000

ZSH="$MOD/bin/zsh"

if [ ! -x "$ZSH" ]; then
    echo "ERROR: bundled zsh not found: $ZSH"
    exit 1
fi

exec "$ZSH" --login
