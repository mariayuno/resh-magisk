#!/system/bin/sh
# resh — Rex's Shell
# Self-contained: uses bundled bins only, no Termux required

MOD="/data/adb/modules/rexshell/files"

export REXSHELL_ACTIVE=1
export HOME="/data/adb/ssh/root"
export PATH="$MOD/bin:/system/bin:/system/xbin"

export LD_LIBRARY_PATH="$MOD/lib:/system/lib64:/vendor/lib64"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

mkdir -p \
  "$HOME/.config/zsh" \
  "$HOME/.local/share" \
  "$HOME/.cache/zsh" \
  "$HOME/.local/state/zsh"

# Point zsh at the bundled function files (compinit, add-zsh-hook, is-at-least, …).
# The Termux zsh binary is compiled with --prefix=/data/data/com.termux/files/usr,
# so on a real Android device it finds nothing in its default fpath.
# We bundle the function dir from the Termux zsh .deb into files/share/zsh/functions/
# and prepend it here so autoload works before any .zshrc runs.
export FPATH="$MOD/share/zsh/functions${FPATH:+:$FPATH}"

export ZDOTDIR="$MOD/config/zsh"
export HISTFILE="$HOME/.local/state/zsh/history"
export HISTSIZE=1000000
export SAVEHIST=1000000

ZSH="$MOD/bin/zsh"
if [ ! -x "$ZSH" ]; then
  printf '\033[1;31m[resh] bundled zsh not found at %s\033[0m\n' "$ZSH"
  printf '[resh] run the GitHub Actions workflow to build bins\n'
  exit 1
fi

exec "$ZSH" --login
