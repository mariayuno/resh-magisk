#!/system/bin/sh
# resh — Rex's Shell
# Self-contained: uses bundled bins only, no Termux required

MOD="/data/adb/modules/rexshell/files"

export REXSHELL_ACTIVE=1
export HOME="/data/adb/ssh/root"

export PATH="$MOD/bin:/system/bin:/system/xbin"
export LD_LIBRARY_PATH="$MOD/lib:/system/lib64:/vendor/lib64"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

mkdir -p \
  "$HOME/.config/zsh" \
  "$HOME/.local/share" \
  "$HOME/.cache/zsh" \
  "$HOME/.local/state/zsh"

# Zsh functions are stored inside category subdirectories
# such as Completion/, Misc/, and VCS_Info/.
FPATH=""

for _zsh_func_dir in "$MOD/share/zsh/functions"/*; do
    [ -d "$_zsh_func_dir" ] || continue
    FPATH="${FPATH:+$FPATH:}$_zsh_func_dir"
done

export FPATH

export ZDOTDIR="$MOD/config/zsh"
export HISTFILE="$HOME/.local/state/zsh/history"
export HISTSIZE=1000000
export SAVEHIST=1000000

ZSH="$MOD/bin/zsh"

if [ ! -x "$ZSH" ]; then
    echo "ERROR: bundled zsh not found: $ZSH"
    exit 1
fi

exec "$ZSH" --login
