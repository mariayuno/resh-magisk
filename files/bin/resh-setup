#!/bin/sh
# resh-setup — install/update rexshell dependencies from Termux
# Run once from Termux or after module install

set -e
REXSHELL_HOME="/data/adb/modules/rexshell/files"
ZSH_CUSTOM="$REXSHELL_HOME/oh-my-zsh/custom"

_has() { command -v "$1" >/dev/null 2>&1; }
_pkg() {
  if _has pkg; then pkg install -y "$@"
  elif _has apt; then apt install -y "$@"
  else echo "No package manager found"; return 1; fi
}

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  resh-setup"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Core deps
echo "[1/4] Core packages..."
_pkg zsh git curl eza bat fzf ripgrep openssh

# oh-my-zsh
echo "[2/4] oh-my-zsh..."
OMZ="$REXSHELL_HOME/oh-my-zsh"
if [ ! -f "$OMZ/oh-my-zsh.sh" ]; then
  mkdir -p "$OMZ"
  git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$OMZ"
else
  echo "  already present, pulling..."
  git -C "$OMZ" pull --ff-only 2>/dev/null || true
fi

# p10k
echo "[3/4] powerlevel10k..."
P10K="$ZSH_CUSTOM/themes/powerlevel10k"
if [ ! -d "$P10K" ]; then
  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$P10K"
else
  git -C "$P10K" pull --ff-only 2>/dev/null || true
fi

# zsh plugins
echo "[4/4] zsh plugins..."
_clone_plugin() {
  local name="$1" url="$2"
  local dest="$ZSH_CUSTOM/plugins/$name"
  if [ ! -d "$dest" ]; then
    git clone --depth=1 "$url" "$dest"
  else
    git -C "$dest" pull --ff-only 2>/dev/null || true
  fi
}
_clone_plugin zsh-autosuggestions     https://github.com/zsh-users/zsh-autosuggestions
_clone_plugin zsh-syntax-highlighting https://github.com/zsh-users/zsh-syntax-highlighting
_clone_plugin z                       https://github.com/agkozak/zsh-z

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✓ Done! Run: resh"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
