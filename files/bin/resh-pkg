#!/system/bin/sh
# resh-pkg — APT/dpkg wrapper for rexshell

MOD="/data/adb/modules/rexshell/files"
RESH="/data/media/0/resh"
TPFX="$RESH/usr"
MANIFEST="$RESH/packages"

die() { echo "resh-pkg: $*" >&2; exit 1; }

apt_env() {
  export HOME="/data/adb/ssh/root"
  export TMPDIR="$RESH/tmp"
  export APT_CONFIG="$TPFX/etc/apt/apt.conf"
  export DPKG_ADMINDIR="$TPFX/var/lib/dpkg"
  export LD_LIBRARY_PATH="$MOD/lib:$TPFX/lib:/system/lib64:/vendor/lib64"
  export PATH="$MOD/bin:$TPFX/bin:/system/bin"
  mkdir -p "$RESH/tmp"
}

apt_cmd() {
  apt_env
  "$MOD/bin/apt" -o "DPkg::Path=$MOD/bin:/system/bin" "$@"
}

dpkg_cmd() {
  apt_env
  "$MOD/bin/dpkg" \
    --root="$RESH" \
    --admindir="$TPFX/var/lib/dpkg" \
    --force-not-root \
    --force-bad-path \
    "$@"
}

init_prefix() {
  mkdir -p \
    "$TPFX/bin" "$TPFX/lib" \
    "$TPFX/etc/apt/apt.conf.d" \
    "$TPFX/etc/apt/sources.list.d" \
    "$TPFX/etc/apt/trusted.gpg.d" \
    "$TPFX/var/lib/apt/lists/partial" \
    "$TPFX/var/lib/apt/lists/auxfiles" \
    "$TPFX/var/cache/apt/archives/partial" \
    "$TPFX/var/lib/dpkg/info" \
    "$TPFX/var/lib/dpkg/updates" \
    "$TPFX/var/lib/dpkg/alternatives" \
    "$TPFX/var/log/apt" \
    "$RESH/tmp"

  [ -f "$TPFX/var/lib/dpkg/status" ]    || touch "$TPFX/var/lib/dpkg/status"
  [ -f "$TPFX/var/lib/dpkg/available" ] || touch "$TPFX/var/lib/dpkg/available"

  write_apt_config
  write_sources_list
  install_keyring
}

write_apt_config() {
  local conf="$TPFX/etc/apt/apt.conf"
  # Regenerate if missing or if module path changed
  if grep -q "rexshell" "$conf" 2>/dev/null && grep -q "$MOD" "$conf" 2>/dev/null; then
    return 0
  fi
  cat > "$conf" << APTCONF
// rexshell APT config — auto-generated, do not edit
Dir "$RESH/";
Dir::State "usr/var/lib/apt/";
Dir::State::status "usr/var/lib/dpkg/status";
Dir::Cache "usr/var/cache/apt/";
Dir::Etc "usr/etc/apt/";
Dir::Log "usr/var/log/apt/";
Dir::Bin::dpkg "$MOD/bin/dpkg";
DPkg::Options {
  "--root=$RESH";
  "--admindir=$TPFX/var/lib/dpkg";
  "--force-not-root";
  "--force-bad-path";
  "--force-confnew";
}
APT::Architecture "aarch64";
APT::Architectures { "aarch64"; };
APT::Install-Recommends "false";
APT::Install-Suggests "false";
Dir::Bin::gpg "$MOD/bin/gpgv";
APT::Sandbox::User "root";
APTCONF
}

write_sources_list() {
  local sl="$TPFX/etc/apt/sources.list"
  [ -f "$sl" ] && return 0
  echo "deb https://packages.termux.dev/apt/termux-main stable main" > "$sl"
}

install_keyring() {
  local dst="$TPFX/etc/apt/trusted.gpg.d/termux-keyring.gpg"
  [ -f "$dst" ] && return 0
  if [ -f "$MOD/etc/termux-keyring.gpg" ]; then
    cp "$MOD/etc/termux-keyring.gpg" "$dst"
  else
    echo "resh-pkg: warning: keyring not found — run 'resh-pkg update --allow-insecure'" >&2
  fi
}

cmd_update() {
  init_prefix
  if [ "${1:-}" = "--allow-insecure" ]; then
    apt_cmd update --allow-insecure-repositories
  else
    apt_cmd update || die "apt update failed"
  fi
}

cmd_upgrade() {
  init_prefix
  apt_cmd full-upgrade || die "apt full-upgrade failed"
}

cmd_install() {
  local pkg="$1"
  [ -z "$pkg" ] && die "usage: resh-pkg install <package>"
  init_prefix
  ls "$TPFX/var/lib/apt/lists/"*_Packages >/dev/null 2>&1 || { echo "→ no package lists — running update..."; cmd_update; }
  apt_cmd install -y "$pkg" || die "apt install $pkg failed"
  mkdir -p "$(dirname "$MANIFEST")"
  touch "$MANIFEST"
  grep -qx "$pkg" "$MANIFEST" || echo "$pkg" >> "$MANIFEST"
  echo "✓ $pkg installed"
}

cmd_remove() {
  local pkg="$1"
  [ -z "$pkg" ] && die "usage: resh-pkg remove <package>"
  init_prefix
  apt_cmd remove -y "$pkg" || die "apt remove $pkg failed"
  [ -f "$MANIFEST" ] && { grep -v "^${pkg}$" "$MANIFEST" > "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST" || true; }
  echo "✓ $pkg removed"
}

cmd_list() {
  init_prefix
  dpkg_cmd --list 2>/dev/null | awk '/^ii/{printf "  %-30s %s\n", $2, $3}'
}

cmd_files() {
  local pkg="$1"
  [ -z "$pkg" ] && die "usage: resh-pkg files <package>"
  init_prefix
  dpkg_cmd --listfiles "$pkg" 2>/dev/null || die "$pkg not installed"
}

cmd_restore() {
  [ -f "$MANIFEST" ] || { echo "no manifest — nothing to restore"; exit 0; }
  init_prefix
  cmd_update
  local count=0 failed=0
  while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    echo "→ restoring $pkg..."
    if apt_cmd install -y "$pkg"; then
      count=$((count + 1))
    else
      echo "  ⚠ $pkg failed"
      failed=$((failed + 1))
    fi
  done < "$MANIFEST"
  echo "restore: $count ok, $failed failed"
  [ "$failed" -eq 0 ] || exit 1
}

case "${1:-}" in
  install) cmd_install "$2" ;;
  remove)  cmd_remove  "$2" ;;
  update)  cmd_update  "${2:-}" ;;
  upgrade) cmd_upgrade ;;
  restore) cmd_restore ;;
  list)    cmd_list ;;
  files)   cmd_files "$2" ;;
  *)
    echo "usage: resh-pkg install|remove|update|upgrade|restore|list|files"
    ;;
esac
