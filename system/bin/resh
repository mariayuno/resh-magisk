#!/system/bin/sh
# resh — Rex's Shell
# Self-contained: bundled tools only

MOD="/data/adb/modules/rexshell/files"

export REXSHELL_ACTIVE=1
export HOME="/data/adb/ssh/root"

export PATH="$MOD/bin:/system/bin:/system/xbin"
export LD_LIBRARY_PATH="$MOD/lib:/system/lib64:/vendor/lib64"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

mkdir -p \
  "$HOME/.config/zsh" \
  "$HOME/.local/share" \
  "$HOME/.cache/zsh" \
  "$HOME/.local/state/zsh"

# Zsh functions are stored in a nested directory tree.
# Include every directory so autoload can find:
#   Completion/Base/_call_program
#   VCS_Info/Backends/VCS_INFO_detect_git
#   Misc/add-zsh-hook
#   etc.
FPATH=""

while IFS= read -r _zsh_func_dir; do
    [ -d "$_zsh_func_dir" ] || continue

    if [ -z "$FPATH" ]; then
        FPATH="$_zsh_func_dir"
    else
        FPATH="$FPATH:$_zsh_func_dir"
    fi
done <<EOF
$(find "$MOD/share/zsh/functions" -type d 2>/dev/null | sort)
EOF

export FPATH

export ZDOTDIR="$MOD/config/zsh"
export HISTFILE="$HOME/.local/state/zsh/history"
export HISTSIZE=1000000
export SAVEHIST=1000000

ZSH="$MOD/bin/zsh"

if [ ! -x "$ZSH" ]; then
    echo "ERROR: bundled zsh not found: $ZSH"
    exit 1
fi

exec "$ZSH" --login
