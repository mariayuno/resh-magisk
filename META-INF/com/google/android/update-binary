#!/sbin/sh
SKIPUNZIP=1
MODDIR="/data/adb/modules/rexshell"

ui_print() { echo "$1"; }
ui_print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
ui_print "  rexshell"
ui_print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

mkdir -p "$MODDIR"
unzip -o "$ZIPFILE" 'files/*' -d "$MODDIR" >&2

# Mark bins executable
chmod 755 "$MODDIR/files/bin/"*

# Hook SSH: write .profile into root home so login shell auto-execs resh
SSH_HOME="/data/adb/ssh/root"
mkdir -p "$SSH_HOME"

# Backup existing .profile if not ours
if [ -f "$SSH_HOME/.profile" ] && ! grep -q "rexshell" "$SSH_HOME/.profile" 2>/dev/null; then
  cp "$SSH_HOME/.profile" "$SSH_HOME/.profile.bak"
fi

cat > "$SSH_HOME/.profile" << 'PROFILE'
#!/bin/sh
# rexshell ssh hook
[ -n "$REXSHELL_ACTIVE" ] && return 0
export REXSHELL_ACTIVE=1
exec /data/adb/modules/rexshell/files/bin/resh
PROFILE
chmod 644 "$SSH_HOME/.profile"

ui_print "  ✓ SSH hook: /data/adb/ssh/root/.profile"
ui_print "  ✓ Invoke manually: resh"
ui_print "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
