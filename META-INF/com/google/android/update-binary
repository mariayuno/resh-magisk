#!/sbin/sh
#################
# Initialization
#################

umask 022

ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*********************************"
  ui_print " Please install Magisk v20.4+!   "
  ui_print "*********************************"
  exit 1
}

#########################
# Load util_functions.sh
#########################

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk

###################
# Standard install
###################

# install_module extracts the zip into $MODPATH, copies module.prop,
# sources customize.sh, sets perms/contexts, and registers the module
# with Magisk — this replaces all of that logic that used to be
# hand-rolled (and broken) here.
install_module
exit 0
